PORT=5000
MONGO_URI=mongodb://localhost:27017/
JWT_SECRET=change-me-to-at-least-32-chars-secret
CLIENT_URL=http://localhost:5173

# Bootstrap admin created once if missing — change after login in production.
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeMe_Strong#

# SMTP (optional — without these, mails are skipped + logged.)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Placement Portal <noreply@college.edu>"

# Tune rate-limit if behind proxy/CDN:
RATE_LIMIT_MAX=300

NODE_ENV=development
